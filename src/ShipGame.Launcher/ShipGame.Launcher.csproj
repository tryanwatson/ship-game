<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Single-file builds (Windows, Linux) unpack everything on first run: MonoGame only finds SDL and OpenAL on disk. -->
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>..\ShipGame.Client\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\ShipGame.Client\Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- MonoGame looks for these by name in the entry assembly for the window icon. -->
    <EmbeddedResource Include="..\ShipGame.Client\Icon.ico" LogicalName="Icon.ico" />
    <EmbeddedResource Include="..\ShipGame.Client\Icon.bmp" LogicalName="Icon.bmp" />
    <!-- The launcher draws with the client's built-in font rather than depending on the whole client. -->
    <Compile Include="..\ShipGame.Client\Rendering\PixelFont.cs" Link="Rendering\PixelFont.cs" />
    <Compile Include="..\ShipGame.Client\Rendering\PrimitiveBatch.cs" Link="Rendering\PrimitiveBatch.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ShipGame.Launcher.Tests" />
  </ItemGroup>
</Project>
